---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title,
  description = '面向校园与开源社区的镜像服务。查找 Linux 发行版、开发工具与镜像使用帮助。',
} = Astro.props;
const nav = [
  { href: '/', label: '镜像列表' },
  { href: '/docs/', label: '使用帮助' },
  { href: '/blog/', label: '镜像站动态' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#549b35" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>
      {title ? `${title} · NAOSI Mirrors` : 'NAOSI Mirrors · 开源镜像站'}
    </title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳转到主要内容</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a href="/" class="brand" aria-label="NAOSI Mirrors 首页"
          ><img
            class="brand-symbol"
            src="/favicon.svg"
            width="51"
            height="38"
            alt=""
          /><span
            ><strong>NAOSI <span class="brand-light">MIRRORS</span></strong
            ></span
          ></a
        >
        <nav aria-label="主导航">
          {
            nav.map(({ href, label }) => (
              <a
                href={href}
                aria-current={
                  (
                    href === '/'
                      ? Astro.url.pathname === '/'
                      : Astro.url.pathname.startsWith(href)
                  )
                    ? 'page'
                    : undefined
                }
              >
                {label}
              </a>
            ))
          }
        </nav>
        <a class="community-link" href="https://naosi.org/"
          >NAOSI 社区 <span aria-hidden="true">↗</span></a
        >
      </div>
    </header>
    <main id="main" class="shell"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <div>
          <strong>开放，让每一次连接更有价值。</strong><p>
            以分享汇聚力量，以开源连接彼此。
          </p>
        </div><div class="footer-links">
          <a href="https://naosi.org/">NAOSI</a><a
            href="https://github.com/NAOSI-DLUT/dlut-mirrors">GitHub ↗</a
          ><a href="/blog/hello/">关于本站</a>
        </div>
      </div>
    </footer>
  </body>
</html>

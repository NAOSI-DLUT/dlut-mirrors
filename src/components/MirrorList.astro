<div class="mirror-list">
  <div id="mirror-table-container">
    <p class="text-gray-500">加载中...</p>
  </div>
</div>

<script>
  function getStatusBadge(status: string): { color: string; text: string } {
    const statusMap: Record<string, { color: string; text: string }> = {
      success: { color: "status-success", text: "完成" },
      syncing: { color: "status-syncing", text: "同步中" },
      failed: { color: "status-failed", text: "失败" },
    };
    return statusMap[status] || { color: "status-badge", text: "未知" };
  }

  function formatDate(dateString: string): string {
    if (!dateString || dateString.includes("0001")) return "-";
    try {
      const date = new Date(dateString);
      return date.toLocaleString("zh-CN");
    } catch {
      return dateString;
    }
  }

  async function loadMirrors() {
    const container = document.getElementById("mirror-table-container");
    if (!container) return;

    try {
      const response = await fetch("/mirrors.json");
      const mirrors = await response.json();

      container.innerHTML = `
        <div class="overflow-x-auto">
          <table class="border-collapse">
            <thead class="bg-gray-100">
              <tr>
                <th class="border border-gray-300 px-4 py-2 text-left">名称</th>
                <th class="border border-gray-300 px-4 py-2 text-left">描述</th>
                <th class="border border-gray-300 px-4 py-2 text-center">状态</th>
                <th class="border border-gray-300 px-4 py-2 text-left">大小</th>
                <th class="border border-gray-300 px-4 py-2 text-left">最后更新</th>
                <th class="border border-gray-300 px-4 py-2 text-left">下一次同步</th>
              </tr>
            </thead>
            <tbody>
              ${mirrors
                .map((mirror: any) => {
                  const statusBadge = getStatusBadge(mirror.status);
                  return `
                    <tr class="hover:bg-gray-50 transition">
                      <td class="border border-gray-300 px-4 py-2 font-semibold">${mirror.name}</td>
                      <td class="border border-gray-300 px-4 py-2 text-sm">${mirror.description || "-"}</td>
                      <td class="border border-gray-300 px-4 py-2 text-center">
                        <span class="status-badge ${statusBadge.color}">${statusBadge.text}</span>
                      </td>
                      <td class="border border-gray-300 px-4 py-2 text-sm">${mirror.size}</td>
                      <td class="border border-gray-300 px-4 py-2 text-sm text-gray-600">${formatDate(mirror.last_update)}</td>
                      <td class="border border-gray-300 px-4 py-2 text-sm text-gray-600">${formatDate(mirror.next_schedule)}</td>
                    </tr>
                  `;
                })
                .join("")}
            </tbody>
          </table>
        </div>
      `;
    } catch (err) {
      container.innerHTML = `<p class="text-red-500">加载镜像列表失败，请刷新重试。</p>`;
      console.error("Failed to load mirrors:", err);
    }
  }

  loadMirrors();
</script>

<style>
  .mirror-list {
    margin: 2rem 0;
  }

  .status-badge {
    display: inline-block;
    padding: 0.15em 0.5em;
    border-radius: 0.25rem;
    font-size: 0.85em;
    font-weight: 500;
  }

  .status-success {
    background-color: #d1fae5;
    color: #065f46;
  }

  .status-syncing {
    background-color: #fef3c7;
    color: #92400e;
  }

  .status-failed {
    background-color: #fee2e2;
    color: #991b1b;
  }

  .overflow-x-auto {
    overflow-x: auto;
  }

  .border-collapse {
    border-collapse: collapse;
    width: 100%;
  }

  .border {
    border-width: 1px;
  }

  .border-gray-300 {
    border-color: #d1d5db;
  }

  .px-4 {
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .py-2 {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  .text-left {
    text-align: left;
  }

  .text-center {
    text-align: center;
  }

  .text-sm {
    font-size: 0.875rem;
  }

  .text-gray-600 {
    color: #4b5563;
  }

  .font-semibold {
    font-weight: 600;
  }

  .bg-gray-100 {
    background-color: #f3f4f6;
  }

  .hover\:bg-gray-50:hover {
    background-color: #f9fafb;
  }

  .transition {
    transition-property: background-color;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 150ms;
  }

  .text-gray-500 {
    color: #6b7280;
  }

  .text-red-500 {
    color: #ef4444;
  }
</style>

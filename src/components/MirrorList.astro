---
import { getCollection } from 'astro:content';
import { mirrorDocs } from '../lib/docs-metadata';
const metadata = mirrorDocs(await getCollection('docs'));
const categories = [
  '全部镜像',
  ...new Set([
    ...Object.values(metadata).map((doc) => doc.category),
    '其他镜像',
  ]),
];
---

<section
  data-mirror-docs={JSON.stringify(metadata)}
  class="mirror-panel panel"
  aria-labelledby="mirror-heading"
>
  <div class="panel-heading">
    <div>
      <span class="eyebrow">EXPLORE THE OPEN SOURCE</span><h2
        id="mirror-heading"
      >
        镜像列表 <span class="count" id="mirror-count">—</span>
      </h2>
    </div><button id="refresh" class="text-button" hidden>↻ 刷新数据</button>
  </div>
  <div id="mirror-controls" hidden>
    <label class="search-field" for="mirror-search"
      ><span aria-hidden="true">⌕</span><input
        id="mirror-search"
        type="search"
        placeholder="搜索 CERNET 镜像名称…"
        aria-label="搜索镜像"
      /><kbd aria-hidden="true">/</kbd></label
    >
    <div class="filter-row">
      <div class="category-filters" role="group" aria-label="镜像分类">
        {
          categories.map((name, i) => (
            <button
              data-category={i === 0 ? '' : name}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {name}
            </button>
          ))
        }
      </div><span class="routing-label">CERNET 智能调度</span>
    </div>
  </div>
  <div class="table-scroll mirror-scroll">
    <table>
      <caption class="sr-only"
        >CERNET 仓库目录，访问时自动选择高校镜像站</caption
      ><thead
        ><tr
          ><th scope="col">镜像名称</th><th scope="col">分类</th><th scope="col"
            >访问</th
          ><th scope="col">帮助</th></tr
        ></thead
      ><tbody id="mirror-rows"></tbody>
    </table>
  </div>
  <div id="empty-state" class="empty-state" hidden>
    <strong>没有找到匹配的镜像</strong><p>
      试试其他关键词，或清除筛选条件。
    </p><button id="clear-filters" class="button secondary">清除筛选</button>
  </div>
  <p id="initial-error" class="empty-state">
    正在读取镜像目录… <a href="https://mirrors.cernet.edu.cn/"
      >也可访问 CERNET ↗</a
    >
  </p>
  <div class="table-footer">
    <span id="feed-message" role="status" aria-live="polite"
      >目录来自 CERNET · 文件由各高校镜像站提供</span
    ><a href="/mirrors.json">查看 JSON ↗</a>
  </div>
  <noscript
    ><p class="table-footer">
      请启用 JavaScript 查看本站目录，或<a href="https://mirrors.cernet.edu.cn/"
        >前往 CERNET 搜索 ↗</a
      >
    </p></noscript
  >
</section>
<script src="../lib/mirror-client.ts"></script>
